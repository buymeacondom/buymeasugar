# ── Telegram Bot ──────────────────────────────────────────────
# Get token from @BotFather. MUST be set — bot will not start without it.
BOT_TOKEN=your_token_here

# ── Optional overrides (bot.py defaults shown) ────────────────
# Bot username (no @) used for blue command links in the welcome card
# BOT_USERNAME=scarlet

